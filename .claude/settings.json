{
  "autoUpdatesChannel": "stable",
  "autoCompactThreshold": 80,
  "model": "claude-opus-4-8",
  "notifications": true,
  "promptSuggestionEnabled": false,
  "preferredNotifChannel": "ghostty",
  "switchModelsOnFlag": false,
  "theme": "dark",
  "useAutoModeDuringPlan": true,
  "verbose": true,

  "bash": {
    "allowedCommands": [
      "npm test",
      "npm run lint",
      "git status",
      "git diff",
      "ls",
      "cat",
      "echo"
    ],
    "deniedCommands": [
      "rm -rf",
      "git push --force",
      "sudo",
      "DROP TABLE",
      "truncate"
    ]
  }
}
